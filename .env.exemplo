# Conexão PostgreSQL com Supabase (pooler transaction).
# A senha fica separada da URL; caracteres especiais não precisam ser codificados.
SUPABASE_DB_URL=postgresql://postgres.gbhvxtfzzjmavwminyoe@aws-1-us-west-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=
BANCO_SSLMODE=require

# Segredo aleatório com pelo menos 32 caracteres para assinar tokens da aplicação.
JWT_SEGREDO=
JWT_MINUTOS=60

# Origem exata do frontend liberada pelo CORS.
ORIGEM_FRONTEND=http://localhost:5173

# E-mail para receber links de redefinição das contas de demonstração.
EMAIL_RECUPERACAO=waldemarrobertokuehn@gmail.com

# Gmail SMTP: use uma senha de app (não a senha normal da conta Google).
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=

# O arquivo .env real fica na raiz do repositório; este exemplo documenta o mesmo formato.
# Supabase PostgreSQL via pooler transaction. A senha fica separada da URL.
SUPABASE_DB_URL=postgresql://postgres.gbhvxtfzzjmavwminyoe@aws-1-us-west-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=
BANCO_SSLMODE=require

# Segredo aleatório com pelo menos 32 caracteres.
JWT_SEGREDO=
JWT_MINUTOS=60
ORIGEM_FRONTEND=http://localhost:5173

# SMTP com STARTTLS para envio de links temporários de redefinição de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

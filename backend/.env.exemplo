# Endereço exato do meu front, lido pelo main.py para montar o CORS.
# Aqui a chave vem com o valor de exemplo, para dar para copiar o arquivo tal
# qual; no seu .env, o valor tem que ser o endereço que o seu front usa.
ORIGEM_FRONTEND=http://localhost:5173

# Conexão com o MySQL, lida pelo configuracao.py e usada pelo banco.py.
# O nome do banco é traco_fino, sem acento, que é o que o esquema.sql cria.
# ATENÇÃO: a senha NÃO vai aqui neste arquivo de exemplo. A senha é segredo, fica
# só no seu .env, que o .gitignore esconde do Git. Por isso a linha da senha está
# comentada aqui, e só aqui.
BANCO_HOST=localhost
BANCO_PORTA=3306
BANCO_NOME=traco_fino
BANCO_USUARIO=root
#BANCO_SENHA=
